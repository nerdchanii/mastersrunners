{
  "version": 1,
  "review_artifacts_dir": "tasks/reviews",
  "sources": {
    "openai_subagents": "https://developers.openai.com/codex/subagents",
    "openai_skills": "https://developers.openai.com/codex/skills",
    "claude_subagents": "https://code.claude.com/docs/en/sub-agents",
    "claude_skills": "https://code.claude.com/docs/en/skills"
  },
  "routing_rules": {
    "docs": ["docs-reviewer", "po-reviewer"],
    "web_default": ["frontend-reviewer", "po-reviewer"],
    "web_user_facing": ["frontend-reviewer", "ui-ux-reviewer", "po-reviewer"],
    "api_or_db": ["backend-reviewer", "po-reviewer"],
    "meta_ci_repo_deploy": ["harness-reviewer", "po-reviewer"]
  },
  "reviewers": {
    "docs-reviewer": {
      "kind": "specialist",
      "codex_agent": ".codex/agents/docs-reviewer.toml",
      "codex_skills": [
        ".agents/skills/review-output-contract/SKILL.md",
        ".agents/skills/docs-review-checklist/SKILL.md"
      ],
      "claude_agent": ".claude/agents/docs-reviewer.md",
      "claude_skills": [
        ".claude/skills/review-output-contract/SKILL.md",
        ".claude/skills/docs-review-checklist/SKILL.md"
      ]
    },
    "frontend-reviewer": {
      "kind": "specialist",
      "codex_agent": ".codex/agents/frontend-reviewer.toml",
      "codex_skills": [
        ".agents/skills/review-output-contract/SKILL.md",
        ".agents/skills/frontend-review-checklist/SKILL.md"
      ],
      "claude_agent": ".claude/agents/frontend-reviewer.md",
      "claude_skills": [
        ".claude/skills/review-output-contract/SKILL.md",
        ".claude/skills/frontend-review-checklist/SKILL.md"
      ]
    },
    "ui-ux-reviewer": {
      "kind": "specialist",
      "codex_agent": ".codex/agents/ui-ux-reviewer.toml",
      "codex_skills": [
        ".agents/skills/review-output-contract/SKILL.md",
        ".agents/skills/ui-ux-review-checklist/SKILL.md"
      ],
      "claude_agent": ".claude/agents/ui-ux-reviewer.md",
      "claude_skills": [
        ".claude/skills/review-output-contract/SKILL.md",
        ".claude/skills/ui-ux-review-checklist/SKILL.md"
      ]
    },
    "backend-reviewer": {
      "kind": "specialist",
      "codex_agent": ".codex/agents/backend-reviewer.toml",
      "codex_skills": [
        ".agents/skills/review-output-contract/SKILL.md",
        ".agents/skills/backend-review-checklist/SKILL.md"
      ],
      "claude_agent": ".claude/agents/backend-reviewer.md",
      "claude_skills": [
        ".claude/skills/review-output-contract/SKILL.md",
        ".claude/skills/backend-review-checklist/SKILL.md"
      ]
    },
    "harness-reviewer": {
      "kind": "specialist",
      "codex_agent": ".codex/agents/harness-reviewer.toml",
      "codex_skills": [
        ".agents/skills/review-output-contract/SKILL.md",
        ".agents/skills/harness-review-checklist/SKILL.md"
      ],
      "claude_agent": ".claude/agents/harness-reviewer.md",
      "claude_skills": [
        ".claude/skills/review-output-contract/SKILL.md",
        ".claude/skills/harness-review-checklist/SKILL.md"
      ]
    },
    "po-reviewer": {
      "kind": "po",
      "codex_agent": ".codex/agents/po-reviewer.toml",
      "codex_skills": [
        ".agents/skills/review-output-contract/SKILL.md",
        ".agents/skills/po-review-checklist/SKILL.md"
      ],
      "claude_agent": ".claude/agents/po-reviewer.md",
      "claude_skills": [
        ".claude/skills/review-output-contract/SKILL.md",
        ".claude/skills/po-review-checklist/SKILL.md"
      ]
    }
  }
}
