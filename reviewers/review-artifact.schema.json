{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastersrunners.local/reviewers/review-artifact.schema.json",
  "title": "Reviewer Artifact",
  "type": "object",
  "required": [
    "task_id",
    "reviewer",
    "decision",
    "tool",
    "review_contract",
    "executed_protocol_paths",
    "reviewed_at",
    "findings",
    "residual_risks"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^I-[0-9]{4}-[0-9]{3}$"
    },
    "reviewer": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": ["approved", "changes_requested"]
    },
    "tool": {
      "type": "string"
    },
    "review_contract": {
      "type": "string",
      "enum": ["repo-reviewer-artifact-v1"]
    },
    "executed_protocol_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "compatible_protocol_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewed_at": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "summary"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "summary": {
            "type": "string"
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
