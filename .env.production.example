# Environment
NODE_ENV=production

# Database
# Runtime pooled connection (Cloud Run / API runtime)
DATABASE_URL=postgresql://<db-user>.<project-ref>:<db-password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
# Operator / migration connection (Prisma CLI)
DIRECT_URL=postgresql://<db-user>.<project-ref>:<db-password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require

# Frontend
FRONTEND_URL=https://your-domain.com
OPS_FRONTEND_URL=https://ops.your-domain.com

# API
API_PORT=4000
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_POLICY_AUD=your-cloudflare-access-audience

# Redis
REDIS_URL=redis://localhost:6379

# JWT (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=change-me-in-production-use-strong-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# OAuth - Kakao
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_CALLBACK_URL=https://your-domain.com/api/v1/auth/kakao/callback

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-domain.com/api/v1/auth/google/callback

# Storage (disk | r2) — defaults to disk in development, r2 in production
STORAGE_TYPE=r2

# Cloudflare R2 (required when STORAGE_TYPE=r2)
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-r2-domain.com
