{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["apps/web/src/*"],
      "@masters/database": ["packages/database/src/index.ts"],
      "@masters/types": ["packages/types/src"]
    }
  },
  "include": [
    "apps/api/src/**/*.ts",
    "apps/web/src/**/*.ts",
    "apps/web/src/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx"
  ],
  "exclude": ["node_modules", "**/dist/**", "**/.next/**", "**/coverage/**"]
}
