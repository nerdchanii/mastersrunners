{
  "name": "mastersrunners",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "build": "pnpm -r run build",
    "build:web": "pnpm --filter @masters/web build",
    "build:ops-web": "pnpm --filter @masters/ops-web build",
    "lint": "pnpm -r run lint",
    "typecheck": "bash scripts/run-typecheck.sh",
    "check:ux-copy": "node scripts/check-ux-copy-patterns.mjs --strict",
    "knip": "bash scripts/run-knip.sh",
    "format": "prettier . --write",
    "format:check": "prettier --check --ignore-unknown AGENTS.md README.md DEPLOYMENT.md design docs/README.md docs/guides docs/runbooks docs/reports tasks scripts .github package.json",
    "precommit": "bash scripts/pre-commit.sh",
    "commitmsg:check": "commitlint",
    "prepare": "node scripts/run-if-bin.mjs husky",
    "ci:local": "bash scripts/ci-local.sh",
    "depcruise": "dependency-cruiser --config .dependency-cruiser.cjs apps packages",
    "deploy:verify": "bash scripts/verify-deployment.sh",
    "worktree:bootstrap": "bash scripts/bootstrap-worktree.sh",
    "worktree:bootstrap:test": "bash scripts/test-bootstrap-worktree.sh",
    "db:migrate": "pnpm --filter @masters/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @masters/database db:migrate:deploy",
    "db:push": "pnpm --filter @masters/database db:push",
    "db:seed": "pnpm --filter @masters/database db:seed",
    "db:studio": "pnpm --filter @masters/database db:studio",
    "db:generate": "pnpm --filter @masters/database db:generate",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "dependency-cruiser": "^17.4.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "knip": "^6.11.0",
    "prettier": "^3.8.3",
    "typescript": "^6",
    "typescript-eslint": "^8.59.2"
  },
  "packageManager": "pnpm@10.28.2"
}
